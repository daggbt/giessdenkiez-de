{
	"name": "perth-tree-watering",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc && vite build",
		"lint": "ESLINT_USE_FLAT_CONFIG=true eslint \"src/**/*\"",
		"prettier": "prettier --write .",
		"prettier:ci": "prettier --check .",
		"preview": "vite preview",
		"import:trees": "tsx scripts/import-trees/index.ts",
		"test": "npm run test:unit",
		"test:unit": "vitest run --config ./tests/unit/vitest.config.ts",
		"test:e2e": "playwright test --config=tests/e2e/playwright.config.ts"
	},
	"dependencies": {
		"@supabase/supabase-js": "2.116.0",
		"date-fns": "4.4.0",
		"mapbox-gl": "3.30.0",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"react-markdown": "10.1.0",
		"react-share": "5.3.0",
		"zustand": "5.0.15"
	},
	"devDependencies": {
		"@playwright/test": "1.63.0",
		"@technologiestiftung/eslint-config": "0.4.1",
		"@technologiestiftung/prettier-config": "1.0.0",
		"@types/geojson": "^7946.0.16",
		"@types/node": "^26.6.5",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@typescript-eslint/eslint-plugin": "8.70.0",
		"@typescript-eslint/parser": "8.70.0",
		"@vitejs/plugin-react": "6.1.1",
		"autoprefixer": "10.6.1",
		"dotenv": "17.4.2",
		"eslint": "10.10.0",
		"globals": "17.12.0",
		"postcss": "8.5.28",
		"prettier": "3.9.6",
		"prettier-plugin-tailwindcss": "0.8.1",
		"tailwindcss": "3.4.19",
		"tsx": "^4.23.15",
		"typescript": "6.0.3",
		"vite": "8.3.0",
		"vitest": "5.0.1"
	},
	"overrides": {
		"typescript-eslint": "8.70.0"
	}
}
